# Copie para backend/.env (que NUNCA vai para o git) e preencha.
# No Render, cadastre as mesmas variáveis em Dashboard > Environment.

# Banco Turso. Sem estas duas, o desenvolvimento local usa backend/database.sqlite.
# No Render elas são obrigatórias (o servidor não sobe sem elas).
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Segredo que assina os tokens de login. Use um texto longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se ficar vazio, é derivado do TURSO_AUTH_TOKEN. Trocar desconecta todo mundo.
AUTH_SECRET=

# Códigos de convite aceitos no cadastro, separados por vírgula.
# Os antigos (JOGO2026, PELADA2026) estão no histórico público do repositório.
INVITE_CODES=
